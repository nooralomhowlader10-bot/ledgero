# ─────────────────────────────────────────────────────────────────────────────
# Ledgero — Environment Configuration Template
# Copy this file to .env and fill in your Firebase project values.
# NEVER commit .env or real secret keys to version control.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Public Firebase Web SDK Configuration (Restricted by HTTP Referrer + Firestore Rules)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_MESSAGING_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# 2. Optional Server-Side Gemini AI Proxy URL
# IMPORTANT: Do NOT put raw Gemini API keys in VITE_* variables, as Vite bundles
# VITE_* variables into client-side JavaScript. Either configure a server-side
# proxy endpoint here or use the in-app ephemeral sessionStorage BYOK input.
VITE_GEMINI_PROXY_URL=
